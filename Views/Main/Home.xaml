<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Agora.Views.Main.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Agora.Views.Main"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  TitleBar  -->
            <RowDefinition Height="*" />
            <!--  NavigationView  -->
        </Grid.RowDefinitions>

        <TitleBar
            Title="Agora"
            x:Name="titleBar"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="titleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/AgorasLogo.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
            Width="360"
            VerticalAlignment="Center"
            PlaceholderText="Buscar.."
            QueryIcon="Find" />
            </TitleBar.Content>
            <!--TitleBar.RightHeader>
                <PersonPicture
            Width="30"
            Height="30"
            Initials="JD" />
            </TitleBar.RightHeader-->
        </TitleBar>
        <NavigationView
            x:Name="MainNav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="LeftCompact"
            IsPaneToggleButtonVisible="False"
            >
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Home" Content="Inicio" Tag="Inicio" SelectsOnInvoked="True"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Cerrar Sesión" Tag="Logout">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF3B1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <!-- Aquí anidamos el FeedNav DENTRO del MainNav, reemplazando el Main Frame -->
            <NavigationView
                x:Name="FeedNav"
                IsBackButtonVisible="Collapsed"
                PaneDisplayMode="Top"
                ItemInvoked="FeedNav_ItemInvoked"
                IsSettingsVisible="False"
                IsPaneToggleButtonVisible="False">
                
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="ParaTi" Tag="ForYou"/>
                    <NavigationViewItem Content="Siguiendo" Tag="Following"/>
                </NavigationView.MenuItems>
             
                <Frame x:Name="SubFrame" Margin="0,10,0,0"/>
            </NavigationView>

        </NavigationView>

    </Grid>
</Page>
