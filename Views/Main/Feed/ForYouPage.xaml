<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Agora.Views.Main.Feed.ForYouPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Agora.Views.Main.Feed"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Agora.Models"
    xmlns:components="using:Agora.Components.Post"
    mc:Ignorable="d">

    <Grid>
        <ListView x:Name="FeedListView" 
                  ItemsSource="{x:Bind ViewModel.myforYou, Mode=OneWay}" 
                  SelectionMode="None">
            <ListView.ItemTemplate>

                <!-- Le decimos: "Ojo, cada elemento que te llega es del tipo Posts" -->
                <DataTemplate x:DataType="models:Posts">

                    <!-- Y por cada Posts, dibujamos tu componente PostCard y le inyectamos los datos -->
                    <components:PostCard PostData="{x:Bind}" Margin="0,0,0,15" />

                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
