<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Agora.Components.Post.MediaGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Agora.Components.Post"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:models="using:Agora.Models"
    mc:Ignorable="d">

    <Grid>
        <FlipView ItemsSource="{x:Bind ListaDeFotos, Mode=OneWay}" 
                  Height="300" 
                  CornerRadius="8"
                  Margin="0,15,0,0">

            <FlipView.ItemTemplate>
                <!-- Decimos que cada elemento de la lista es un MediaFeature -->
                <DataTemplate x:DataType="models:MediaFeature">

                    <!-- Dibujamos la imagen leyendo la columna 'Image' de la BD -->
                    <Image Source="{x:Bind Image, Mode=OneWay}" 
                           Stretch="Uniform" 
                           Tapped="Image_Tapped"/>

                </DataTemplate>
            </FlipView.ItemTemplate>

        </FlipView>

    </Grid>
</UserControl>
